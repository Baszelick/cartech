# Database
# Neon pooled connection used by the running backend.
DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@NEON_POOLED_HOST/NEON_DATABASE?sslmode=require"
# Neon direct connection used by Prisma CLI operations and the seed script.
DIRECT_URL="postgresql://NEON_USER:NEON_PASSWORD@NEON_DIRECT_HOST/NEON_DATABASE?sslmode=require"

# JWT
JWT_ACCESS_SECRET="GENERATE_A_RANDOM_SECRET"
JWT_REFRESH_SECRET="GENERATE_A_DIFFERENT_RANDOM_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Refresh token cookie
REFRESH_COOKIE_NAME="cartech_refresh_token"
# Must stay aligned with JWT_REFRESH_EXPIRES_IN (7 days = 604800000 ms).
REFRESH_TOKEN_TTL_MS="604800000"

# Runtime
NODE_ENV="development"
PORT="3000"

# CORS
FRONTEND_URL="http://localhost:4200"
