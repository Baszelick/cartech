      "frontend": {
        "name": "frontend",
        "type": "app",
        "data": {
          "root": "apps/frontend",
          "targets": {
            "lint": {
              "cache": true,
              "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/eslint.config.mjs",
                "{workspaceRoot}/tools/eslint-rules/**/*",
                {
                  "externalDependencies": [
                    "eslint"
                  ]
                }
              ],
              "outputs": [
                "{options.outputFile}"
              ],
              "metadata": {
                "technologies": [
