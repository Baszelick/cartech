{
  "name": "cartech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.14.x",
    "npm": "10.9.x"
  },
  "scripts": {
    "verify": "npm run lint && npm run test && npm run build",
    "verify:deps": "npm ls --depth=0",
    "setup:check": "node tools/check-environment.mjs",
    "dev": "nx run-many -t serve -p backend,frontend --parallel=2",
    "serve:backend": "nx serve backend",
    "serve:frontend": "nx serve frontend",
    "build": "nx run-many -t build -p backend,frontend",
    "build:backend": "nx build backend",
    "build:frontend": "nx build frontend",
    "test": "nx run-many -t test -p backend,frontend",
    "test:backend": "nx test backend",
    "test:frontend": "nx test frontend",
    "lint": "nx run-many -t lint -p backend,frontend",
    "lint:backend": "nx lint backend",
    "lint:frontend": "nx lint frontend",
    "prisma:generate": "prisma generate --config apps/backend/prisma.config.ts",
    "prisma:validate": "prisma validate --config apps/backend/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config apps/backend/prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config apps/backend/prisma.config.ts",
    "prisma:reset": "prisma migrate reset --config apps/backend/prisma.config.ts",
    "prisma:studio": "prisma studio --config apps/backend/prisma.config.ts",
    "seed": "prisma db seed --config apps/backend/prisma.config.ts"
  },
  "dependencies": {
    "@angular/animations": "21.2.9",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/platform-browser-dynamic": "21.2.9",
    "@angular/router": "21.2.9",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@ngrx/signals": "21.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/cookie-parser": "^1.4.10",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "luxon": "3.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2102.9",
    "@angular-devkit/core": "21.2.9",
    "@angular-devkit/schematics": "21.2.9",
    "@angular/build": "^21.2.9",
    "@angular/cli": "21.2.9",
    "@angular/compiler-cli": "21.2.9",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@nx/angular": "^23.1.0",
    "@nx/eslint-plugin": "^23.1.0",
    "@nx/js": "^23.1.0",
    "@nx/webpack": "^23.1.0",
    "@nx/workspace": "^23.1.0",
    "@schematics/angular": "20.3.32",
    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jasmine": "5.1.8",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.1",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^20.3.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jasmine-core": "5.6.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "nx": "^23.1.0",
    "prettier": "~3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "29.4.12",
    "ts-loader": "^9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
